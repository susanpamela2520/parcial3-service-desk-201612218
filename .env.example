# Copie este archivo como .env y cambie los valores. NO suba .env a Git.
# Todas las credenciales son exclusivamente de demostración/evaluación.
POSTGRES_DB=catalogo
POSTGRES_USER=catalogo
POSTGRES_PASSWORD=cambie-esta-clave-local
APP_PORT=8000
SESSION_HOURS=8

# Cuentas de evaluación creadas por: docker compose exec app python -m scripts.seed_demo
DEMO_ADMIN_USUARIO=admin
DEMO_ADMIN_PASSWORD=Admin-Demo-2026
DEMO_CONSULTA_USUARIO=consulta
DEMO_CONSULTA_PASSWORD=Consulta-Demo-2026

# Usuarios del Service Desk (solicitante, agente1, agente2, aprobador): scripts.seed_service_desk
DEMO_USUARIOS_PASSWORD=Usuario-Demo-2026
# Generador de la CMDB (scripts.generar_cmdb)
CMDB_SEMILLA=2026
CMDB_CANTIDAD=5000
